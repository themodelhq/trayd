// ============================================================
// TRAY'D ENTERPRISE TRADING PLATFORM
// PRISMA DATABASE SCHEMA
// ============================================================
// Complete database schema for cryptocurrency and forex trading
// Supports: Users, Authentication, Trading, Wallets, Markets, AI, Admin
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTHENTICATION MODELS
// ============================================================

/**
 * User - Core user account model
 * Stores authentication credentials and profile information
 */
model User {
  id                String       @id @default(cuid())
  email             String       @unique
  emailVerified     Boolean      @default(false)
  emailVerificationToken   String?
  emailVerifiedAt          DateTime?
  
  // Username & Profile
  username          String?     @unique
  firstName         String?
  lastName          String?
  displayName       String?
  avatarUrl         String?
  phone             String?
  phoneVerified     Boolean      @default(false)
  
  // Password & Security
  passwordHash      String?  // Null for OAuth-only users
  twoFASecret       String?
  twoFAEnabled      Boolean      @default(false)
  lastPasswordChange DateTime?
  
  // Roles & Status
  role              String       @default("user") // user, trader, verified, premium, admin, super_admin
  kycStatus         String       @default("not_started") // not_started, pending, submitted, under_review, approved, rejected
  accountStatus     String       @default("active") // active, suspended, banned, frozen, pending_verification
  
  // OAuth Providers
  googleId          String?
  appleId           String?
  githubId          String?
  facebookId        String?
  
  // Preferences (stored as JSON)
  preferences       String       @default("{}")
  
  // Referral System
  referralCode      String       @unique @default(cuid())
  referredBy        String?  // User ID of referrer
  
  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  lastLoginAt       DateTime?

  // Relations
  sessions          Session[]
  devices           DeviceSession[]
  wallets           Wallet[]
  orders            Order[]
  positions         Position[]
  trades            Trade[]
  transactions      Transaction[]
  notifications     Notification[]
  watchlists        WatchlistItem[]
  priceAlerts       PriceAlert[]
  journalEntries    JournalEntry[]
  copySubscriptions CopySubscription[] @relation("CopyFollower")
  copyFollowers     CopySubscription[] @relation("CopyTrader")
  achievements      UserAchievement[]
  referralRewards   ReferralReward[] @relation("ReferredUser")
  referralGiven     ReferralReward[] @relation("Referrer")
  kycSubmission     KycSubmission?
  supportTickets    SupportTicket[]
  consentRecords    ConsentRecord[]
  auditLogs         AuditLog[] @relation("UserLogs")
  aiConversations   AIConversation[]
  
  @@index([email])
  @@index([username])
  @@index([referralCode])
  @@index([role])
  @@index([accountStatus])
  @@map("users")
}

/**
 * Session - User session for JWT token management
 */
model Session {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String
  refreshToken   String   @unique
  ipAddress      String?
  userAgent      String?
  deviceType     String?  // desktop, mobile, tablet
  isActive       Boolean  @default(true)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([refreshToken])
  @@index([isActive])
  @@map("sessions")
}

/**
 * DeviceSession - Device login history for security
 */
model DeviceSession {
  id            String    @id @default(cuid())
  userId        String
  deviceId      String
  deviceName    String?
  deviceType    String    // desktop, mobile, tablet
  os            String?
  browser       String?
  ipAddress     String
  location      String?
  isActive      Boolean   @default(true)
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([deviceId])
  @@map("device_sessions")
}

// ============================================================
// KYC & COMPLIANCE MODELS
// ============================================================

/**
 * KycSubmission - Know Your Customer verification submissions
 */
model KycSubmission {
  id               String    @id @default(cuid())
  userId           String    @unique
  status           String    @default("pending") // pending, submitted, under_review, approved, rejected
  documentType     String    // passport, id_card, drivers_license, residence_permit
  documentFrontUrl String
  documentBackUrl  String?
  selfieUrl        String
  submittedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewerId       String?   // Admin user ID
  rejectionReason  String?
  
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@map("kyc_submissions")
}

/**
 * ConsentRecord - User consent for GDPR/privacy compliance
 */
model ConsentRecord {
  id            String    @id @default(cuid())
  userId        String
  consentType   String    // terms_of_service, privacy_policy, marketing, data_sharing
  version       String
  granted       Boolean
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  ipAddress     String
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([consentType])
  @@map("consent_records")
}

// ============================================================
// MARKET DATA MODELS
// ============================================================

/**
 * MarketAsset - Available trading instruments
 */
model MarketAsset {
  id                  String   @id @default(cuid())
  symbol              String   @unique  // BTC/USDT, EUR/USD
  name                String
  baseAsset           String   // BTC, EUR
  quoteAsset          String   // USDT, USD
  category            String   // crypto, forex, indices, commodities, stocks, etf, futures, options
  iconUrl             String?
  isActive            Boolean  @default(true)
  
  // Trading Configuration
  minOrderSize        Float    @default(0.0001)
  maxOrderSize        Float    @default(1000000)
  orderStep           Float    @default(0.0001)
  priceStep           Float    @default(0.01)
  minPrice            Float    @default(0)
  maxPrice            Float    @default(999999999)
  leverageMin         Int      @default(1)
  leverageMax         Int      @default(100)
  feeMaker            Float    @default(0.1)  // percentage
  feeTaker            Float    @default(0.15)  // percentage
  
  // Metadata (JSON)
  metadata            String   @default("{}")
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relations
  orders              Order[]
  positions           Position[]
  trades              Trade[]
  watchlistItems      WatchlistItem[]
  priceAlerts         PriceAlert[]
  candles             CandleData[]
  
  @@index([symbol])
  @@index([category])
  @@index([isActive])
  @@map("market_assets")
}

/**
 * CandleData - Historical OHLCV candlestick data
 */
model CandleData {
  id        String   @id @default(cuid())
  assetId   String
  symbol    String
  timeframe String   // 1m, 5m, 15m, 30m, 1h, 4h, 1d, 1w, 1M
  openTime  BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  
  asset     MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@unique([symbol, timeframe, openTime])
  @@index([assetId])
  @@index([symbol, timeframe])
  @@map("candle_data")
}

// ============================================================
// TRADING MODELS
// ============================================================

/**
 * Order - Trade orders (open, filled, cancelled)
 */
model Order {
  id                String    @id @default(cuid())
  userId            String
  assetId           String
  symbol            String
  
  // Order Details
  type              String    // market, limit, stop, stop_limit, oco, iceberg, trailing_stop, basket, recurring
  side              String    // buy, sell
  status            String    @default("pending") // pending, open, partially_filled, filled, cancelled, rejected, expired
  
  // Pricing
  price             Float?    // Limit price
  stopPrice         Float?    // Stop trigger price
  averagePrice      Float?    // Fill price (weighted avg)
  
  // Quantities
  quantity          Float
  filledQuantity    Float     @default(0)
  remainingQuantity Float
  
  // Order Settings
  timeInForce       String    @default("GTC") // GTC, IOC, FOK, GTX, DAY
  leverage          Int       @default(1)
  marginMode        String    @default("cross") // cross, isolated
  reduceOnly        Boolean   @default(false)
  postOnly          Boolean   @default(false)
  
  // Fees
  fee               Float     @default(0)
  feeCurrency       String    @default("USDT")
  
  // P&L (for closed/filled orders)
  profitLoss        Float?
  profitLossPercent Float?
  
  // Metadata (JSON) - stores OCO, iceberg, etc.
  metadata          String    @default("{}")
  
  // Client order ID for idempotency
  clientOrderId     String?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  filledAt          DateTime?
  cancelledAt       DateTime?
  expiresAt         DateTime?
  
  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset             MarketAsset @relation(fields: [assetId], references: [id])
  trades            Trade[]
  position          Position? @relation(fields: [positionId], references: [id])
  positionId        String?
  
  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("orders")
}

/**
 * Position - Open trading positions
 */
model Position {
  id                String    @id @default(cuid())
  userId            String
  assetId           String
  symbol            String
  side              String    // buy (long), sell (short)
  
  // Size & Price
  size              Float
  entryPrice        Float
  markPrice         Float
  liquidationPrice  Float
  
  // Leverage & Margin
  leverage          Int       @default(1)
  marginMode        String    @default("cross")
  marginUsed        Float     @default(0)
  
  // P&L
  unrealizedPnl     Float     @default(0)
  realizedPnl       Float     @default(0)
  pnlPercent        Float     @default(0)
  
  // Funding (for perpetual futures)
  fundingFee        Float?
  fundingRate       Float?
  nextFundingTime   DateTime?
  
  // Timestamps
  openTime          DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  closeTime         DateTime?
  
  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset             MarketAsset @relation(fields: [assetId], references: [id])
  orders            Order[]
  trades            Trade[]
  
  @@index([userId])
  @@index([symbol])
  @@index([side])
  @@map("positions")
}

/**
 * Trade - Individual trade executions (fills)
 */
model Trade {
  id            String    @id @default(cuid())
  orderId       String
  positionId    String?
  userId        String
  assetId       String
  symbol        String
  
  side          String    // buy, sell
  price         Float
  quantity      Float
  fee           Float     @default(0)
  feeCurrency   String    @default("USDT")
  commission    Float     @default(0)
  isMaker       Boolean   @default(false)
  liquidation   Boolean   @default(false)
  
  time          DateTime  @default(now())
  
  // Relations
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position      Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         MarketAsset @relation(fields: [assetId], references: [id])
  
  @@index([orderId])
  @@index([userId])
  @@index([symbol])
  @@index([time])
  @@map("trades")
}

// ============================================================
// WALLET & PAYMENT MODELS
// ============================================================

/**
 * Wallet - User wallet accounts (fiat, crypto, margin, etc.)
 */
model Wallet {
  id                String   @id @default(cuid())
  userId            String
  type              String   @default("fiat") // fiat, crypto, margin, earnings, bonus
  currency          String   // USD, EUR, BTC, USDT, etc.
  balance           Float    @default(0)
  availableBalance  Float    @default(0)
  frozenBalance     Float    @default(0)
  
  // Crypto-specific fields
  address           String?
  network           String?  // ERC20, TRC20, BEP20, etc.
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  
  @@unique([userId, currency, type])
  @@index([userId])
  @@index([currency])
  @@map("wallets")
}

/**
 * Transaction - All financial transactions
 */
model Transaction {
  id                String    @id @default(cuid())
  walletId          String
  userId            String
  type              String    // deposit, withdrawal, transfer, trade, fee, refund, etc.
  status            String    @default("pending") // pending, processing, completed, failed, cancelled, reversed, refunded
  amount            Float
  fee               Float     @default(0)
  currency          String
  description       String
  
  // External References
  referenceId       String?   // Payment provider reference
  externalTxHash    String?   // Blockchain tx hash
  
  // Metadata (JSON)
  metadata          String    @default("{}")
  
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  
  // Relations
  wallet            Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// ============================================================
// WATCHLIST & ALERTS MODELS
// ============================================================

/**
 * WatchlistItem - User's saved watchlist items
 */
model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  assetId     String
  symbol      String
  label       String?
  sortOrder   Int      @default(0)
  addedAt     DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@unique([userId, symbol])
  @@index([userId])
  @@map("watchlist_items")
}

/**
 * PriceAlert - User-configured price alerts
 */
model PriceAlert {
  id            String   @id @default(cuid())
  userId        String
  assetId       String
  symbol        String
  condition     String   // above, below
  targetPrice   Float
  triggered     Boolean  @default(false)
  triggeredAt   DateTime?
  oneTime       Boolean  @default(true)
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([triggered])
  @@map("price_alerts")
}

// ============================================================
// COPY TRADING MODELS
// ============================================================

/**
 * CopySubscription - Active copy trading subscriptions
 */
model CopySubscription {
  id                String    @id @default(cuid())
  followerId        String    // User who is copying
  traderId          String    // Trader profile ID (user ID)
  traderUserId      String    // Trader's actual user ID
  
  allocationAmount  Float     @default(0)
  allocationPercent Float     @default(100)
  copyOpenTrades    Boolean   @default(true)
  maxRiskPercent    Float     @default(5)
  stopLoss          Float?
  takeProfit        Float?
  status            String    @default("active") // active, paused, cancelled
  
  totalCopied       Int       @default(0)
  totalPnl          Float     @default(0)
  
  startedAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  follower          User      @relation("CopyFollower", fields: [followerId], references: [id], onDelete: Cascade)
  trader            User      @relation("CopyTrader", fields: [traderUserId], references: [id], onDelete: Cascade)
  
  @@index([followerId])
  @@index([traderUserId])
  @@index([status])
  @@map("copy_subscriptions")
}

// ============================================================
// JOURNAL & ANALYTICS MODELS
// ============================================================

/**
 * JournalEntry - Trading journal entries
 */
model JournalEntry {
  id                String    @id @default(cuid())
  userId            String
  tradeId           String?
  title             String
  content           String
  mood              String    @default("neutral") // positive, neutral, negative
  tags              String    @default("[]") // JSON array
  screenshots       String    @default("[]") // JSON array of URLs
  lessonLearned     String?
  mistakesMade      String?
  whatWentWell      String?
  strategy          String?
  setupQuality      Int?      // 1-5 rating
  executionQuality  Int?      // 1-5 rating
  riskRewardRatio   Float?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@map("journal_entries")
}

// ============================================================
// NOTIFICATION MODELS
// ============================================================

/**
 * Notification - User notifications
 */
model Notification {
  id            String    @id @default(cuid())
  userId        String
  title         String
  message       String
  category      String    // trade, order, price_alert, news, system, security, social, payment, marketing
  priority      String    @default("medium") // low, medium, high, urgent
  read          Boolean   @default(false)
  actionUrl     String?
  actionLabel   String?
  icon          String?
  metadata      String    @default("{}")
  
  createdAt     DateTime  @default(now())
  readAt        DateTime?
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// REFERRAL & REWARDS MODELS
// ============================================================

/**
 * ReferralReward - Earned referral rewards
 */
model ReferralReward {
  id               String   @id @default(cuid())
  referrerId       String   // User who referred
  referredUserId   String   // User who was referred
  referredUsername String
  amount           Float
  type             String   // signup, deposit, trade, tier_bonus
  status           String   @default("pending") // pending, available, claimed, expired
  earnedAt         DateTime @default(now())
  availableAt      DateTime
  expiresAt        DateTime?
  claimedAt        DateTime?
  
  referrer         User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser     User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  
  @@index([referrerId])
  @@index([referredUserId])
  @@index([status])
  @@map("referral_rewards")
}

/**
 * AchievementDefinition - Available achievements/badges
 */
model AchievementDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  category    String
  rarity      String   @default("common") // common, rare, epic, legendary
  maxProgress Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  userAchievements UserAchievement[]
  
  @@map("achievement_definitions")
}

/**
 * UserAchievement - Unlocked achievements per user
 */
model UserAchievement {
  id                String   @id @default(cuid())
  userId            String
  achievementId     String
  progress          Int      @default(0)
  unlockedAt        DateTime?
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement       AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ============================================================
// SUPPORT TICKETS MODEL
// ============================================================

/**
 * SupportTicket - Customer support tickets
 */
model SupportTicket {
  id            String    @id @default(cuid())
  userId        String
  subject       String
  description   String
  category      String
  priority      String    @default("medium") // low, medium, high, urgent
  status        String    @default("open") // open, in_progress, waiting, resolved, closed
  assignedTo    String?   // Admin user ID
  resolvedAt    DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]
  
  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@map("support_tickets")
}

/**
 * TicketMessage - Messages within support tickets
 */
model TicketMessage {
  id            String    @id @default(cuid())
  ticketId      String
  senderId      String
  senderRole    String    // user, support, admin
  content       String
  attachments   String    @default("[]") // JSON array of URLs
  createdAt     DateTime  @default(now())
  
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
  @@map("ticket_messages")
}

// ============================================================
// AI FEATURES MODELS
// ============================================================

/**
 * AIConversation - AI chat conversation threads
 */
model AIConversation {
  id            String    @id @default(cuid())
  userId        String
  title         String?
  type          String    @default("general") // general, analysis, trading_advice
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AIMessage[]
  
  @@index([userId])
  @@map("ai_conversations")
}

/**
 * AIMessage - Individual AI chat messages
 */
model AIMessage {
  id            String    @id @default(cuid())
  conversationId String
  role          String    // user, assistant, system
  content       String
  sources       String?   // JSON array of citations
  createdAt     DateTime  @default(now())
  
  conversation  AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId])
  @@map("ai_messages")
}

// ============================================================
// ADMIN & AUDIT LOGS
// ============================================================

/**
 * AuditLog - System audit trail for compliance
 */
model AuditLog {
  id            String    @id @default(cuid())
  userId        String?   // User being acted upon (if applicable)
  adminId       String?   // Admin performing action
  action        String    // create_user, update_role, approve_kyc, etc.
  resource      String    // users, orders, wallets, etc.
  resourceId    String?
  details       String    @default("{}") // JSON object with action details
  ipAddress     String
  userAgent     String
  timestamp     DateTime  @default(now())
  
  user          User?     @relation("UserLogs", fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================
// SYSTEM CONFIGURATION MODEL
// ============================================================

/**
 * SystemConfig - Key-value store for platform configuration
 */
model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("general") // general, trading, fees, features, security
  isPublic    Boolean  @default(false) // Can be read by non-admin users
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  
  @@index([key])
  @@index([category])
  @@map("system_config")
}
